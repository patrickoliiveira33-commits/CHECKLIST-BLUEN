rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOdParams(od) {
      return od is map
        && od.keys().hasAll(['currentOd', 'referenceOd', 'currentRpm', 'currentAeration', 'currentPressure', 'currentTemp'])
        && od.keys().hasOnly(['currentOd', 'referenceOd', 'currentRpm', 'currentAeration', 'currentPressure', 'currentTemp'])
        && od.currentOd is number && od.currentOd >= 0 && od.currentOd <= 100
        && od.referenceOd is number && od.referenceOd >= 0 && od.referenceOd <= 100
        && od.currentRpm is number && od.currentRpm >= 0 && od.currentRpm <= 230
        && od.currentAeration is number && od.currentAeration >= 0 && od.currentAeration <= 200
        && od.currentPressure is number && od.currentPressure >= 0 && od.currentPressure <= 0.85
        && od.currentTemp is number && od.currentTemp >= 0 && od.currentTemp <= 60;
    }

    function isValidCultivationTracker(tracker) {
      return tracker is map
        && tracker.keys().hasAll(['isRunning', 'elapsedSeconds', 'lastTickTimestamp', 'startedClockTime', 'autoLogEvery2h'])
        && tracker.keys().hasOnly(['isRunning', 'elapsedSeconds', 'lastTickTimestamp', 'startedClockTime', 'autoLogEvery2h'])
        && tracker.isRunning is bool
        && tracker.elapsedSeconds is number && tracker.elapsedSeconds >= 0 && tracker.elapsedSeconds <= 864000
        && (tracker.lastTickTimestamp == null || (tracker.lastTickTimestamp is number && tracker.lastTickTimestamp >= 0))
        && (tracker.startedClockTime == null || (tracker.startedClockTime is string && tracker.startedClockTime.size() <= 30))
        && tracker.autoLogEvery2h is bool;
    }

    function isValidBioprocessBatch(data) {
      return data.keys().hasAll([
          'operatorName',
          'batchNumber',
          'tankId',
          'startedAt',
          'generalNotes',
          'odParams',
          'cultivationTracker',
          'twoHourLogs',
          'o2Modifications',
          'updatedAtClient',
          'updatedAtMs',
          'updatedByDevice'
        ])
        && data.keys().hasOnly([
          'operatorName',
          'batchNumber',
          'tankId',
          'startedAt',
          'generalNotes',
          'odParams',
          'cultivationTracker',
          'twoHourLogs',
          'o2Modifications',
          'updatedAtClient',
          'updatedAtMs',
          'updatedByDevice'
        ])
        && data.operatorName is string && data.operatorName.size() <= 120
        && data.batchNumber is string && data.batchNumber.size() <= 80
        && data.tankId is string && data.tankId.size() <= 80
        && data.startedAt is string && data.startedAt.size() <= 60
        && data.generalNotes is string && data.generalNotes.size() <= 3000
        && isValidOdParams(data.odParams)
        && isValidCultivationTracker(data.cultivationTracker)
        && data.twoHourLogs is map && data.twoHourLogs.size() <= 20
        && data.o2Modifications is list && data.o2Modifications.size() <= 200
        && (data.o2Modifications.size() == 0 || data.o2Modifications[0] is map)
        && data.updatedAtClient is string && data.updatedAtClient.size() <= 60
        && data.updatedAtMs is number && data.updatedAtMs >= 0
        && data.updatedByDevice is string && data.updatedByDevice.size() <= 80;
    }

    match /bioprocessBatches/{batchId} {
      allow get: if isValidId(batchId);

      allow create: if isValidId(batchId)
        && isValidBioprocessBatch(incoming());

      allow update: if isValidId(batchId)
        && isValidBioprocessBatch(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'operatorName',
          'batchNumber',
          'tankId',
          'startedAt',
          'generalNotes',
          'odParams',
          'cultivationTracker',
          'twoHourLogs',
          'o2Modifications',
          'updatedAtClient',
          'updatedAtMs',
          'updatedByDevice'
        ]);
    }
  }
}
